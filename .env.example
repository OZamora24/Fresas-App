# Copy this file to .env.local for local testing, and enter the same
# values in Vercel's Project Settings → Environment Variables when you deploy.

# --- Supabase (Settings -> API in your Supabase project) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login ---
# The password you'll type on /admin to see the dashboard.
ADMIN_PASSWORD=choose-a-password
# Any long random string — used to sign the admin login cookie.
# You can generate one at https://generate-secret.vercel.app/32
SESSION_SECRET=change-this-to-a-random-string

# --- OneSignal (push notifications) ---
# From OneSignal -> Settings -> Keys & IDs
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
# Same App ID again, but exposed to the browser (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
